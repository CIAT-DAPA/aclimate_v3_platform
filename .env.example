# ============================================================
# AClimate v3 Platform — Environment Variables
# ============================================================
# Copy this file to .env and adjust ONLY the ports and
# non-URL values. All service URLs are generated automatically
# by compose.yaml from these values.
#
#   docker compose --profile db up -d   # with local DBs
#   docker compose up -d                 # with external DBs
#
# ⚠️ SECURITY: NEVER put real secrets/credentials here.
# This file is committed to the repo. Use placeholders and
# define real values in your local .env (gitignored).
# ============================================================

# ─── External ports (change these to remap host ports) ──────
KEYCLOAK_PORT=8080
GEOSERVER_PORT=8600
WEBAPI_PORT=3002
FRONTEND_PORT=3000

# ─── Keycloak admin (CHANGE_ME in .env) ─────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ─── WebAPI (non-URL variables, same names as src/.env) ──────
REALM_NAME=aclimate
CLIENT_ID=aclimate_frontend_honduras
CLIENT_SECRET=CHANGE_ME
GEOSERVER_USER=geoserver_user
GEOSERVER_PASSWORD=CHANGE_ME
MAX_WORKERS=4
MAX_SYNC_DAYS=7
HEALTH_TOKEN=CHANGE_ME

# ─── Frontend (non-URL variables, same names as src/.env) ────
NEXT_PUBLIC_KEYCLOAK_REALM=aclimate
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aclimate_frontend_honduras
NEXT_PUBLIC_ACLIMATE_API_FRONTEND_URL=https://userspreferencesapi.aclimate.org
NEXT_PUBLIC_ACLIMATE_APP_ID=4
NEXT_PUBLIC_COUNTRY_NAME=El Salvador
NEXT_PUBLIC_SHOW_STATIONS_MODULE=true
NEXT_PUBLIC_SHOW_USERS_MODULE=false
NEXT_PUBLIC_FORECAST_API_URL=https://srt.snet.gob.sv/apidoa/api
NEXT_PUBLIC_BASE_PATH=
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── Frontend repo path ──────────────────────────────────────
FRONTEND_PATH=../aclimate_v3_frontend

# ─── Monitoring (optional, only with --profile monitoring) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ─── DB infra (only used by Compose to provision DB containers) ──
KEYCLOAK_DB_HOST=db_keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_NAME=keycloak
ACLIMATE_DB_USER=postgres
ACLIMATE_DB_PASSWORD=CHANGE_ME
ACLIMATE_DB_NAME=aclimate_db