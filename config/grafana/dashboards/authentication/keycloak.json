{
  "uid": "keycloak-overview",
  "title": "Keycloak Overview",
  "tags": ["authentication"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "stat", "title": "Uptime", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "time() - process_start_time_seconds{job=\"keycloak\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 2, "type": "stat", "title": "JVM Heap Used", "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "jvm_memory_used_bytes{job=\"keycloak\", area=\"heap\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 3, "type": "stat", "title": "HTTP 5xx Rate", "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(http_server_requests_seconds_count{job=\"keycloak\", outcome=\"SERVER_ERROR\"}[5m])", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "HTTP Requests/sec", "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(http_server_requests_seconds_count{job=\"keycloak\"}[1m])", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "JVM Heap Memory", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "jvm_memory_used_bytes{job=\"keycloak\"}", "legendFormat": "{{area}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "HTTP Request Rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(http_server_requests_seconds_count{job=\"keycloak\"}[1m])", "legendFormat": "{{method}} {{uri}}", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "JVM Threads", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "jvm_threads_live_threads{job=\"keycloak\"}", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "HTTP Status Codes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"keycloak\"}[1m])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A"}]}
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}