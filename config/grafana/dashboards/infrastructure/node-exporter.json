{
  "uid": "node-exporter-full",
  "title": "Node Exporter Full",
  "tags": ["infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU Utilisation",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory Usage",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "100 - ((node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Load Average (1m)",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "node_load1", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "time() - node_boot_time_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network Traffic",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"uid": "prometheus"},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total[1m])", "legendFormat": "RX {{device}}", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total[1m])", "legendFormat": "TX {{device}}", "refId": "B"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Filesystem Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100)", "legendFormat": "{{mountpoint}}", "refId": "A"}]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}