{
  "uid": "container-logs",
  "title": "Container Logs (Loki)",
  "tags": ["logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": {"uid": "loki"},
        "query": "label_values({container=~\".+\"}, container)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "logs", "title": "Container Logs", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0}, "datasource": {"uid": "loki"}, "targets": [{"expr": "{container=~\"$container\"}", "refId": "A"}], "options": {"showTime": true, "sortOrder": "Descending", "enableLogDetails": true}},
    {"id": 2, "type": "timeseries", "title": "Log Volume", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "datasource": {"uid": "loki"}, "targets": [{"expr": "sum(rate({container=~\"$container\"}[1m])) by (container)", "legendFormat": "{{container}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Error Logs", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "datasource": {"uid": "loki"}, "targets": [{"expr": "sum(rate({container=~\"$container\"} |= \"error\" |= \"level=error\" [1m])) by (container)", "legendFormat": "{{container}}", "refId": "A"}]}
  ],
  "annotations": {"list": []}
}